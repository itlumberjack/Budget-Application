@model RecurringDebt
@{
    ViewData["Title"] = Model.Id == 0
        ? Model.Kind switch { BillKind.LivingExpense => "Add a living expense", BillKind.Loan => "Add a loan", _ => "Add a bill" }
        : $"Edit {Model.Title}";
    var kinds = new[]
    {
        (Kind: BillKind.Bill, Icon: "bi-receipt", Hint: "Utilities, cell phone, insurance, subscriptions."),
        (Kind: BillKind.LivingExpense, Icon: "bi-basket", Hint: "Food, gas and other spending that comes every week or two."),
        (Kind: BillKind.Loan, Icon: "bi-bank", Hint: "Mortgage, car loan, credit card. Has an amount owed and interest, and shows on Debt Payoff.")
    };
}

<div class="mx-auto" style="max-width:36rem">
<a asp-action="Index" class="small text-decoration-none"><i class="bi bi-chevron-left"></i> Back</a>
<h1 class="mt-1 mb-3">@ViewData["Title"]</h1>
<div class="card"><div class="card-body p-3 p-md-4">

<form asp-action="Save" method="post" >
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label class="form-label d-block">Type</label>
        <div class="btn-group w-100" role="group" aria-label="Type">
            @foreach (var k in kinds)
            {
                <input type="radio" class="btn-check" name="Kind" id="kind-@k.Kind" value="@k.Kind" checked="@(Model.Kind == k.Kind)" autocomplete="off" />
                <label class="btn btn-outline-primary" for="kind-@k.Kind"><i class="bi @k.Icon me-1"></i>@k.Kind.DisplayName()</label>
            }
        </div>
        @foreach (var k in kinds)
        {
            <div class="form-text kind-hint" data-kind="@k.Kind">@k.Hint</div>
        }
    </div>
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" placeholder="e.g. Power bill" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Company" class="form-label"></label>
        <input asp-for="Company" class="form-control" placeholder="Optional, e.g. Opelika Utilities" />
        <span asp-validation-for="Company" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Amount" class="form-label">Amount each time</label>
        <div class="input-group">
            <span class="input-group-text">$</span>
            <input asp-for="Amount" class="form-control" step="0.01" type="number" inputmode="decimal" />
        </div>
        <div class="form-text">What you pay each time it's due<span class="kind-hint" data-kind="Loan">: the minimum payment</span>.</div>
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label"></label>
        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select"></select>
        <div class="form-text">Need a new one? Add it on <a asp-controller="Categories" asp-action="Index">Categories</a>.</div>
    </div>
    <div class="mb-3">
        <label asp-for="Frequency" class="form-label"></label>
        <select asp-for="Frequency" asp-items="Html.GetEnumSelectList<BillFrequency>()" class="form-select" id="billFrequency"></select>
    </div>
    <div class="mb-3" id="dueDayGroup">
        <label asp-for="DueDay" class="form-label"></label>
        <input asp-for="DueDay" class="form-control" placeholder="Optional, 1 to 31" />
        <div class="form-text">Used to place the bill under the last paycheck before it's due. Without one, it goes under the month's first paycheck.</div>
        <span asp-validation-for="DueDay" class="text-danger"></span>
    </div>
    <div class="mb-3" id="startDateGroup">
        <label asp-for="StartDate" class="form-label"></label>
        <input asp-for="StartDate" type="date" class="form-control" />
        <div class="form-text">Any date it's due, like this Friday. Each month gets a copy for every week (or every other week) from then on.</div>
        <span asp-validation-for="StartDate" class="text-danger"></span>
    </div>
    <div class="form-check form-switch mb-3">
        <input asp-for="IsFixed" class="form-check-input" role="switch" />
        <label asp-for="IsFixed" class="form-check-label"></label>
        <div class="form-text">Turn on for things that have to come out of every payday they fall on, like weekly groceries or gas. Even out and the AI helper only move items that are off (flexible).</div>
    </div>
    <div class="mb-3 ms-md-4" id="paidFromGroup">
        <label asp-for="PaidFromIncomeSourceId" class="form-label"></label>
        <select asp-for="PaidFromIncomeSourceId" class="form-select">
            <option value="">Anyone's: the payday before it's due</option>
            @foreach (var s in (List<IncomeSource>)ViewBag.IncomeSources)
            {
                <option value="@s.Id">@s.Name's</option>
            }
        </select>
        <div class="form-text">Pick a person to always pay this from their paycheck, like food from a weekly check. It goes under their last payday before it's due.</div>
    </div>
    <fieldset class="loan-details border rounded p-3 mb-3" id="loanGroup">
        <legend class="fs-6 fw-semibold float-none w-auto px-1 mb-0"><i class="bi bi-bank me-1"></i> Loan details</legend>
        <p class="form-text">With an amount owed, the loan shows up on <a asp-controller="Debt" asp-action="Index">Debt Payoff</a> with payoff plans.</p>
        <div class="row g-3">
            <div class="col-sm-6">
                <label asp-for="Balance" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="Balance" class="form-control" step="0.01" type="number" inputmode="decimal" placeholder="e.g. 18500" />
                </div>
                <span asp-validation-for="Balance" class="text-danger"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="InterestRate" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="InterestRate" class="form-control" step="0.001" type="number" inputmode="decimal" placeholder="e.g. 6.5" />
                    <span class="input-group-text">%</span>
                </div>
                <span asp-validation-for="InterestRate" class="text-danger"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="PayoffPriority" class="form-label"></label>
                <input asp-for="PayoffPriority" class="form-control" type="number" placeholder="Optional" />
                <div class="form-text">Only used by the custom priority plan.</div>
                <span asp-validation-for="PayoffPriority" class="text-danger"></span>
            </div>
        </div>
    </fieldset>
    <input type="hidden" asp-for="BalanceAsOf" />
    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label"></label>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button class="btn btn-primary px-4"><i class="bi bi-check-lg"></i> Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        @if (Model.Id != 0)
        {
            <button type="submit" class="btn btn-outline-danger ms-auto" formaction="@Url.Action("Delete", new { id = Model.Id })" formnovalidate
                    onclick="return confirm('Delete this bill? Months already created keep their copy.');"><i class="bi bi-trash3"></i> Delete</button>
        }
    </div>
</form>
</div></div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // A monthly bill has a due day; a weekly or every-two-weeks bill has a first due date instead.
        const billFrequency = document.getElementById('billFrequency');
        const showSchedule = () => {
            const monthly = billFrequency.value === '0';
            document.getElementById('dueDayGroup').style.display = monthly ? '' : 'none';
            document.getElementById('startDateGroup').style.display = monthly ? 'none' : '';
            document.getElementById('StartDate').required = !monthly;
        };
        billFrequency.addEventListener('change', showSchedule);
        // Weekly items are usually tied to their payday, so a new one starts out mandatory until you change it.
        const isFixed = document.getElementById('IsFixed');
        let fixedTouched = @(Model.Id != 0 ? "true" : "false");
        isFixed.addEventListener('change', () => fixedTouched = true);
        // Whose payday only matters for mandatory items.
        const showPaidFrom = () => document.getElementById('paidFromGroup').hidden = !isFixed.checked;
        isFixed.addEventListener('change', showPaidFrom);
        showPaidFrom();
        billFrequency.addEventListener('change', () => { if (!fixedTouched) isFixed.checked = billFrequency.value !== '0'; showPaidFrom(); });
        showSchedule();

        // Only loans have loan details. Hidden fields are disabled so they aren't sent (or checked) when saving.
        const loanGroup = document.getElementById('loanGroup');
        const isNew = @(Model.Id == 0 ? "true" : "false");
        const showKind = picked => {
            const kind = document.querySelector('input[name=Kind]:checked').value;
            loanGroup.hidden = loanGroup.disabled = kind !== 'Loan';
            document.querySelectorAll('.kind-hint').forEach(h => h.hidden = h.dataset.kind !== kind);
            // A new living expense starts out weekly and mandatory, like food.
            if (picked && isNew && kind === 'LivingExpense' && billFrequency.value === '0') {
                billFrequency.value = '1'; showSchedule();
                if (!fixedTouched) isFixed.checked = true;
                showPaidFrom();
            }
        };
        document.querySelectorAll('input[name=Kind]').forEach(r => r.addEventListener('change', () => showKind(true)));
        showKind(false);
    </script>
}
