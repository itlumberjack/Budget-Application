@model List<RecurringDebt>
@{
    ViewData["Title"] = "Recurring Debts";
    var groups = Model.GroupBy(d => d.Category).ToList();
}

<div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-3">
    <div>
        <h1 class="mb-1">Recurring Debts</h1>
        <p class="page-subtitle mb-0">Bills that come every month. New months start with these; changing one here leaves months you've already made alone.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add a bill</a>
</div>

@if (Model.Count == 0)
{
    <div class="card empty-state">
        <i class="bi bi-receipt"></i>
        <h2 class="h5 mt-2">No bills yet</h2>
        <p class="text-muted">Add things like your mortgage, power bill and car payment.</p>
        <div><a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add a bill</a></div>
    </div>
}
else
{
    <div class="card stat mb-3 d-flex flex-row align-items-center justify-content-between">
        <div class="label mb-0"><span class="stat-icon icon-spend"><i class="bi bi-calendar2-check"></i></span> Every month (active bills)</div>
        <div class="value money">@Model.Where(d => d.IsActive).Sum(d => d.Amount).ToString("C")</div>
    </div>

    <div class="row g-3">
        @foreach (var g in groups)
        {
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between">
                        <span>@g.Key?.Name</span>
                        <span class="money">@g.Where(d => d.IsActive).Sum(d => d.Amount).ToString("C")</span>
                    </div>
                    <div class="list-group list-group-flush">
                        @foreach (var d in g)
                        {
                            <a asp-action="Edit" asp-route-id="@d.Id" class="list-group-item list-group-item-action d-flex align-items-center gap-3 @(d.IsActive ? "" : "opacity-50")">
                                <div class="flex-grow-1">
                                    <div class="item-title">@d.Title @if (!d.IsActive) { <span class="badge text-bg-secondary">inactive</span> }</div>
                                    <div class="item-meta">
                                        @d.Company
                                        @if (d.DueDay is int due) { <span>@(string.IsNullOrEmpty(d.Company) ? "" : "· ")Due on the @due@(due switch { 1 or 21 or 31 => "st", 2 or 22 => "nd", 3 or 23 => "rd", _ => "th" })</span> }
                                    </div>
                                </div>
                                <div class="fw-semibold money">@d.Amount.ToString("C")</div>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
