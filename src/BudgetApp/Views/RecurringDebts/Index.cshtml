@model List<RecurringDebt>
@{
    ViewData["Title"] = "Bills & Expenses";
    var sections = new[]
    {
        (Kind: BillKind.Bill, Heading: "Bills", Icon: "bi-receipt", Empty: "Utilities, cell phone, insurance, subscriptions."),
        (Kind: BillKind.LivingExpense, Heading: "Living expenses", Icon: "bi-basket", Empty: "Food, gas and other spending that comes every week or two."),
        (Kind: BillKind.Loan, Heading: "Loans", Icon: "bi-bank", Empty: "Mortgage, car loan, credit cards. These show on Debt Payoff.")
    };
}

<div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-3">
    <div>
        <h1 class="mb-1">Bills &amp; Expenses</h1>
        <p class="page-subtitle mb-0">Everything that comes every month, week or two weeks. New months start with these; changing one here leaves months you've already made alone.</p>
    </div>
    <div class="dropdown">
        <button class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" id="addMenu"><i class="bi bi-plus-lg"></i> Add</button>
        <ul class="dropdown-menu dropdown-menu-end">
            @foreach (var sec in sections)
            {
                <li><a class="dropdown-item" asp-action="Create" asp-route-kind="@sec.Kind"><i class="bi @sec.Icon me-2"></i>@sec.Kind.DisplayName()</a></li>
            }
        </ul>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="card empty-state">
        <i class="bi bi-receipt"></i>
        <h2 class="h5 mt-2">No bills yet</h2>
        <p class="text-muted">Add things like your power bill, weekly groceries and car payment.</p>
        <div><a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add a bill</a></div>
    </div>
}
else
{
    <div class="card stat mb-3 d-flex flex-row align-items-center justify-content-between">
        <div class="label mb-0"><span class="stat-icon icon-spend"><i class="bi bi-calendar2-check"></i></span> A typical month (active bills)</div>
        <div class="value money">@Model.Where(d => d.IsActive).Sum(d => d.MonthlyAmount).ToString("C")</div>
    </div>

    @foreach (var sec in sections)
    {
        var items = Model.Where(d => d.Kind == sec.Kind).ToList();
        <section class="mb-4" id="kind-@sec.Kind">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <h2 class="h5 mb-0"><i class="bi @sec.Icon text-brand me-1"></i> @sec.Heading</h2>
            <span class="item-meta">@items.Where(d => d.IsActive).Sum(d => d.MonthlyAmount).ToString("C") a month</span>
        </div>
        @if (items.Count == 0)
        {
            <p class="item-meta">None yet. @sec.Empty <a asp-action="Create" asp-route-kind="@sec.Kind">Add one</a>.</p>
        }
        else
        {
    <div class="row g-3">
        @foreach (var g in items.GroupBy(d => d.Category))
        {
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between">
                        <span>@g.Key?.Name</span>
                        <span class="money">@g.Where(d => d.IsActive).Sum(d => d.MonthlyAmount).ToString("C")</span>
                    </div>
                    <div class="list-group list-group-flush">
                        @foreach (var d in g)
                        {
                            <a asp-action="Edit" asp-route-id="@d.Id" class="list-group-item list-group-item-action d-flex align-items-center gap-3 @(d.IsActive ? "" : "opacity-50")">
                                <div class="flex-grow-1">
                                    <div class="item-title">@d.Title @if (d.IsFixed) { <i class="bi bi-pin-angle-fill text-brand" title="Mandatory: stays on its payday"></i> } @if (!d.IsActive) { <span class="badge text-bg-secondary">inactive</span> }</div>
                                    <div class="item-meta">
                                        @d.Company
                                        @{ var when = d.Frequency switch
                                           {
                                               BillFrequency.Weekly => $"Every {d.StartDate?.DayOfWeek}",
                                               BillFrequency.BiWeekly => $"Every other {d.StartDate?.DayOfWeek}, from {d.StartDate:MMM d}",
                                               _ => d.DueDay is int due ? $"Due on the {Dates.Ordinal(due)}" : null
                                           }; }
                                        @if (when is not null) { <span>@(string.IsNullOrEmpty(d.Company) ? "" : "· ")@when</span> }
                                    </div>
                                    @if (d.IsLoan)
                                    {
                                        <div class="item-meta"><i class="bi bi-bank"></i> @d.Balance!.Value.ToString("C0") owed@(d.InterestRate is decimal r ? $" at {r:0.###}%" : "")</div>
                                    }
                                </div>
                                <div class="fw-semibold money text-end">@d.Amount.ToString("C")@if (d.Frequency != BillFrequency.Monthly) {<div class="item-meta fw-normal">@(d.Frequency == BillFrequency.Weekly ? "a week" : "every 2 weeks")</div>}</div>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
        }
        </section>
    }
}
