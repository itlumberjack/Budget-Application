@model MonthViewModel
@{
    ViewData["Title"] = Model.Title;
    ViewData["Wide"] = true; // room for one column per payday
    var b = Model.Budget;
}

<div class="month-nav d-flex align-items-center gap-2 mb-3">
    <a class="btn btn-outline-secondary icon-btn rounded-circle" title="@Model.Previous.MonthTitle()" aria-label="Previous month"
       href="@Url.RouteUrl("month", new { year = Model.Previous.Year, month = Model.Previous.Month })"><i class="bi bi-chevron-left"></i></a>
    <h1 class="mb-0 flex-grow-1 text-center">@Model.Title</h1>
    <a class="btn btn-outline-secondary icon-btn rounded-circle" title="@Model.Next.MonthTitle()" aria-label="Next month"
       href="@Url.RouteUrl("month", new { year = Model.Next.Year, month = Model.Next.Month })"><i class="bi bi-chevron-right"></i></a>
</div>

@if (b is null)
{
    @* Only reached before any paychecks or bills exist; otherwise the month is built automatically. *@
    <div class="card empty-state mx-auto" style="max-width:34rem">
        <i class="bi bi-calendar-plus"></i>
        <h2 class="h4 mt-2">Nothing to budget yet</h2>
        <p class="text-muted">Add your paychecks and monthly bills, and @Model.Title will build itself from them: a column for every payday, with each bill under the paycheck before it's due.</p>
        <div class="d-flex flex-wrap gap-2 justify-content-center">
            <a asp-controller="Income" asp-action="Create" class="btn btn-primary"><i class="bi bi-wallet2 me-1"></i> Add a paycheck</a>
            <a asp-controller="RecurringDebts" asp-action="Create" class="btn btn-outline-primary"><i class="bi bi-receipt me-1"></i> Add a bill</a>
        </div>
    </div>
    return;
}

@{
    var columns = Model.Columns;
    var payColumns = columns.Where(c => !c.IsUnassigned).ToList();
}

@{
    var spentPct = Model.TotalIncome > 0 ? (int)Math.Min(100, Model.TotalExpenses / Model.TotalIncome * 100) : 0;
    var completePct = Model.TotalExpenses > 0 ? (int)(Model.TotalWithStatus(PaymentStatus.Complete) / Model.TotalExpenses * 100) : 0;
    var pendingPct = Model.TotalExpenses > 0 ? (int)(Model.TotalWithStatus(PaymentStatus.Pending) / Model.TotalExpenses * 100) : 0;
    var usedCategoryIds = b.Expenses.Select(e => e.CategoryId).ToHashSet();
    // With no bills at all, show every section so there's somewhere to add one.
    var canHideEmpty = usedCategoryIds.Count > 0 && usedCategoryIds.Count < Model.Categories.Count;
    var household = Model.Household;
    var split = Model.TotalSplit;
}

@if (b.IsArchived)
{
    <div class="alert alert-secondary d-flex flex-wrap align-items-center gap-2" role="status">
        <i class="bi bi-archive"></i>
        <div class="flex-grow-1">@Model.Title is archived, so it's read-only.</div>
        <form asp-action="Unarchive" method="post">
            <input type="hidden" name="id" value="@b.Id" />
            <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-unlock me-1"></i> Unarchive to make changes</button>
        </form>
    </div>
}

<div class="@(b.IsArchived ? "archived" : "")">
<div id="liveAlerts"></div>
<!-- Totals -->
<div class="row g-3 mb-3" id="monthTotals">
    <div class="col-6 col-lg-3">
        <div class="card stat">
            <div class="label"><span class="stat-icon icon-income"><i class="bi bi-cash-stack"></i></span> Income</div>
            <div class="value money mt-1">@Model.TotalIncome.ToString("C")</div>
            @{ var snowballIncome = b.PayPeriods.SelectMany(p => p.Extras).Where(x => x.FromDebtExtra).Sum(x => x.Amount); }
            <div class="hint">@b.PayPeriods.Count paychecks<span id="snowballIncome" hidden="@(snowballIncome == 0)"> · includes @snowballIncome.ToString("C") extra for debt</span></div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat">
            <div class="label"><span class="stat-icon icon-spend"><i class="bi bi-receipt"></i></span> Planned spending</div>
            <div class="value money mt-1">@Model.TotalExpenses.ToString("C")</div>
            <div class="progress mt-2" role="progressbar" aria-label="Share of income planned" aria-valuenow="@spentPct" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar @(Model.Remaining < 0 ? "bg-danger" : "bg-brand")" style="width:@spentPct%"></div>
            </div>
            <div class="hint mt-1">@spentPct% of income</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat">
            <div class="label"><span class="stat-icon icon-done"><i class="bi bi-check2-circle"></i></span> Complete</div>
            <div class="value money mt-1">@Model.TotalWithStatus(PaymentStatus.Complete).ToString("C")</div>
            <div class="progress mt-2" role="progressbar" aria-label="Share of bills complete or pending">
                <div class="progress-bar bg-complete" style="width:@completePct%"></div>
                <div class="progress-bar bg-pending" style="width:@pendingPct%"></div>
            </div>
            <div class="hint mt-1">Pending <span class="money">@Model.TotalWithStatus(PaymentStatus.Pending).ToString("C")</span> &middot; Not paid <span class="money">@Model.TotalWithStatus(PaymentStatus.NotPaid).ToString("C")</span></div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat @(Model.Remaining < 0 ? "border border-danger" : "")">
            <div class="label"><span class="stat-icon icon-left"><i class="bi bi-piggy-bank"></i></span> Left over</div>
            <div class="value money mt-1 @(Model.Remaining < 0 ? "text-danger" : "text-success")">@Model.Remaining.ToString("C")</div>
            @if (Model.HasPlan)
            {
                var change = Model.Remaining - Model.PlannedRemaining;
                <div class="hint plan-hint">Plan <span class="money">@Model.PlannedRemaining.ToString("C")</span>
                    @if (change != 0) { <span class="money @(change < 0 ? "text-danger" : "text-success")">(@(change > 0 ? "+" : "−")@Math.Abs(change).ToString("C"))</span> }
                </div>
            }
            @if (split.Shared > 0)
            {
                <div class="hint">@Model.Household.FirstPartnerName <span class="money">@split.First.ToString("C")</span> &middot; @Model.Household.SecondPartnerName <span class="money">@split.Second.ToString("C")</span> &middot; buffer <span class="money">@split.Buffer.ToString("C")</span></div>
            }
            else
            {
                <div class="hint">@(Model.Remaining < 0 ? "Planned spending is more than income" : "After every planned bill")</div>
            }
        </div>
    </div>
    @if (!b.IsArchived || Model.HasPlan)
    {
        <div class="col-12">
            <div class="plan-bar d-flex flex-wrap align-items-center gap-2 small text-muted" id="planBar">
                <i class="bi bi-clipboard-data"></i>
                <span class="flex-grow-1">
                    @if (Model.HasPlan)
                    {
                        @:Each payday shows the plan saved @b.PlanSavedAt!.Value.ToString("MMM d 'at' h:mm tt") next to where it stands now.
                    }
                    else
                    {
                        @:The plan is saved when you mark the first bill pending or complete. After that, each payday shows the plan next to where it stands now.
                    }
                </span>
                @if (!b.IsArchived)
                {
                    <form asp-action="SavePlan" method="post"
                          onsubmit="return @(Model.HasPlan ? "confirm('Replace the saved plan with this month as it stands now?')" : "true");">
                        <input type="hidden" name="id" value="@b.Id" />
                        <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-bookmark-check me-1"></i> @(Model.HasPlan ? "Make this the plan" : "Save the plan now")</button>
                    </form>
                }
            </div>
        </div>
    }
</div>

<div class="d-flex flex-wrap align-items-center gap-2 gap-md-3 mb-2">
    <div class="payday-pills flex-grow-1" aria-label="Jump to a payday" id="paydayPills">
        @for (var i = 0; i < columns.Count; i++)
        {
            <button type="button" class="btn btn-sm btn-outline-primary" data-jump="@i">@columns[i].Heading</button>
        }
    </div>
    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#aiModal"
            data-url="@Url.Action("EvenOut")" data-title="Even out paydays" data-icon="bi-distribute-horizontal">
        <i class="bi bi-distribute-horizontal me-1"></i> Even out
    </button>
    <button type="button" class="btn btn-sm btn-ai" data-bs-toggle="modal" data-bs-target="#aiModal"
            data-url="@Url.Action("SuggestArrangement")" data-title="Suggested arrangement" data-icon="bi-stars">
        <i class="bi bi-stars me-1"></i> Suggest arrangement
    </button>
    <div class="form-check form-switch mb-0 small @(canHideEmpty ? "" : "d-none")">
        <input class="form-check-input" type="checkbox" role="switch" id="showEmpty" />
        <label class="form-check-label" for="showEmpty">Show empty sections</label>
    </div>
</div>
<div class="d-flex flex-wrap align-items-center gap-3 mb-2 small text-muted edit-only">
    <span><i class="bi bi-hand-index"></i> Tap a row to edit. Tap the dot to change its status. Drag a bill to move it to another payday.</span>
    <span class="legend"><span class="swatch status-complete"></span> Complete</span>
    <span class="legend"><span class="swatch status-pending"></span> Pending</span>
    <span class="legend"><span class="swatch status-notpaid"></span> Not paid</span>
    <span><i class="bi bi-pin-angle-fill"></i> Mandatory: stays on its payday</span>
    <span><i class="bi bi-exclamation-triangle-fill text-warning"></i> Payday is after the due date</span>
</div>

<form asp-action="MoveExpense" method="post" id="moveForm" class="d-none">
    <input type="hidden" name="id" /><input type="hidden" name="payPeriodId" />
</form>

<!-- One column per payday, like the budget spreadsheet. Every block is a grid row so sections line up across columns. -->
<div class="sheet mb-4" id="sheet">
    <div class="sheet-grid hide-empty" id="sheetGrid" style="--cols: @columns.Count">

        @foreach (var col in columns)
        {
            var isFirst = col == payColumns.FirstOrDefault();
            var isLast = col == payColumns.LastOrDefault();
            var payIds = string.Join(",", col.Paychecks.Select(p => p.Id));
            <div class="sheet-heading @(col.IsUnassigned ? "text-muted" : "")" data-col="@columns.IndexOf(col)" data-pay-target="@col.TargetPayPeriodId">
                @if (isFirst)
                {
                    <form asp-action="ShiftPayday" method="post" class="shift-form shift-prev">
                        <input type="hidden" name="budgetId" value="@b.Id" /><input type="hidden" name="payIds" value="@payIds" /><input type="hidden" name="offset" value="-1" />
                        <button class="btn btn-sm shift-btn" title="Move this payday to @Model.Previous.ToString("MMMM")" aria-label="Move this payday to @Model.Previous.ToString("MMMM")"><i class="bi bi-arrow-left"></i></button>
                    </form>
                }
                <span>@col.Heading</span>
                @if (isLast)
                {
                    <form asp-action="ShiftPayday" method="post" class="shift-form shift-next">
                        <input type="hidden" name="budgetId" value="@b.Id" /><input type="hidden" name="payIds" value="@payIds" /><input type="hidden" name="offset" value="1" />
                        <button class="btn btn-sm shift-btn" title="Move this payday to @Model.Next.ToString("MMMM")" aria-label="Move this payday to @Model.Next.ToString("MMMM")"><i class="bi bi-arrow-right"></i></button>
                    </form>
                }
            </div>
        }

        @* Income *@
        @foreach (var col in columns)
        {
            <div class="sheet-block" data-col="@columns.IndexOf(col)">
                <div class="block-title">
                    Income
                    @if (!col.IsUnassigned)
                    {
                        <button type="button" class="btn btn-sm block-add" title="Add extra money (bonus, overtime...)"
                                data-bs-toggle="modal" data-bs-target="#extraModal" data-pay-ids="@string.Join(",", col.Paychecks.Select(p => p.Id))"><i class="bi bi-plus-lg"></i> extra</button>
                    }
                </div>
                <table class="sheet-table">
                    <thead><tr><th>Item</th><th class="text-end">Net Income</th></tr></thead>
                    <tbody>
                    @foreach (var p in col.Paychecks)
                    {
                        <tr class="clickable" data-bs-toggle="modal" data-bs-target="#payModal"
                            data-id="@p.Id" data-label="@p.Label" data-amount="@p.BaseAmount.ToString("0.00")" data-date="@p.PayDate.ToString("yyyy-MM-dd")">
                            <td>@p.Label <span class="text-muted small">(@p.PayDate.ToString("M/d"))</span>@if (p.ManuallyMoved) {<i class="bi bi-arrow-left-right text-muted small ms-1" title="Moved here by hand. Brad's rule leaves it here."></i>}</td>
                            <td class="text-end money">@p.BaseAmount.ToString("C")</td>
                        </tr>
                        @foreach (var x in p.Extras)
                        {
                            <tr>
                                <td class="ps-3">
                                    + @x.Description
                                    @if (x.FromDebtExtra)
                                    {
                                        <a asp-controller="Debt" asp-action="Index" class="badge badge-snowball text-decoration-none" title="A one-time extra from Debt Payoff. Change or remove it there.">snowball</a>
                                    }
                                    else
                                    {
                                        <form asp-action="DeletePayExtra" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@x.Id" />
                                            <button class="btn btn-link btn-sm text-danger p-0 ms-1" title="Remove">&times;</button>
                                        </form>
                                    }
                                </td>
                                <td class="text-end money">@x.Amount.ToString("C")</td>
                            </tr>
                        }
                    }
                    @if (col.IsUnassigned)
                    {
                        <tr><td colspan="2" class="text-muted small">Bills here aren't under a paycheck yet. Click one to pick a payday.</td></tr>
                    }
                    </tbody>
                    <tfoot><tr><td>Total</td><td class="text-end money">@col.Income.ToString("C")</td></tr></tfoot>
                </table>
            </div>
        }

        @* One block per category *@
        @foreach (var cat in Model.Categories)
        {
            foreach (var col in columns)
            {
                var items = col.Expenses.Where(e => e.CategoryId == cat.Id).OrderBy(e => e.DueDay ?? 99).ThenBy(e => e.Title).ToList();
                <div class="sheet-block @(canHideEmpty && !usedCategoryIds.Contains(cat.Id) ? "empty-cat" : "")" data-col="@columns.IndexOf(col)">
                    <div class="block-title">
                        @cat.Name
                        <button type="button" class="btn btn-sm block-add" title="Add an expense to @cat.Name"
                                data-bs-toggle="modal" data-bs-target="#expenseModal" data-mode="add"
                                data-category="@cat.Id" data-pay="@col.TargetPayPeriodId"><i class="bi bi-plus-lg"></i> add</button>
                    </div>
                    <table class="sheet-table">
                        <thead><tr><th>Item</th><th>Company</th><th class="text-end">Amount</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var e in items)
                        {
                            var next = (PaymentStatus)(((int)e.Status + 1) % 3);
                            // Paydays this bill can be dragged to: not after its due date, and never for a mandatory bill.
                            var targets = b.IsArchived || e.IsFixed ? "" : string.Join(",", columns.Select((c, i) => (c, i))
                                .Where(x => x.c != col && Model.CanMoveTo(x.c, e)).Select(x => x.i));
                            <tr class="clickable status-@e.Status.ToString().ToLower()" draggable="@(targets != "" ? "true" : "false")" data-targets="@targets" data-bs-toggle="modal" data-bs-target="#expenseModal" data-mode="edit"
                                data-id="@e.Id" data-title="@e.Title" data-company="@e.Company" data-amount="@e.Amount.ToString("0.00")"
                                data-due="@e.DueDay" data-category="@e.CategoryId" data-pay="@e.PayPeriodId" data-status="@e.Status" data-fixed="@(e.IsFixed ? "1" : "")"
                                data-kind="@(e.ExtraForDebtId is not null ? "snowball" : e.RecurringDebtId is not null ? "recurring" : "")">
                                <td>
                                    @e.Title
                                    @if (e.DueDay is int due) { <span class="text-muted small">(@Dates.Ordinal(due))</span> }
                                    @if (e.IsFixed) { <i class="bi bi-pin-angle-fill text-muted small" title="Fixed to this payday. Even out and the AI helper leave it here."></i> }
                                    @if (!Model.PaysOnTime(col, e)) { <i class="bi bi-exclamation-triangle-fill text-warning small" title="This payday comes after the bill is due."></i> }
                                    @if (e.ExtraForDebtId is not null) { <span class="badge badge-snowball" title="This payday's share of the extra debt payment from Debt Payoff">snowball</span> }
                                    else if (e.RecurringDebtId is null) { <span class="badge text-bg-secondary">extra</span> }
                                </td>
                                <td>@e.Company</td>
                                <td class="text-end money">
                                    @e.Amount.ToString("C")
                                    @if (Model.OwedAfter.TryGetValue(e.Id, out var owed))
                                    {
                                        <div class="owed-after" title="Left to pay on this debt after this payment">@(owed == 0 ? "paid off" : owed.ToString("C0") + " left")</div>
                                    }
                                    @if (Model.HasPlan && e.PlannedAmount is decimal planned && planned != e.Amount)
                                    {
                                        <div class="plan-was" title="Amount in the plan">plan @planned.ToString("C")</div>
                                    }
                                    else if (Model.HasPlan && e.PlannedAmount is null)
                                    {
                                        <div class="plan-was" title="Added after the plan was saved">not in plan</div>
                                    }
                                </td>
                                <td class="status-cell">
                                    <form asp-action="SetStatus" method="post">
                                        <input type="hidden" name="id" value="@e.Id" />
                                        <input type="hidden" name="status" value="@next" />
                                        <button class="status-dot" title="@e.Status.DisplayName() (click for @next.DisplayName())"
                                                aria-label="Change status"></button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                        <tfoot><tr><td colspan="2">Total</td><td class="text-end money">@items.Sum(e => e.Amount).ToString("C")</td><td></td></tr></tfoot>
                    </table>
                </div>
            }
        }

        @* What's left from each paycheck *@
        @foreach (var col in columns)
        {
            <div class="sheet-block sheet-summary" data-col="@columns.IndexOf(col)">
                @if (Model.HasPlan && !col.IsUnassigned)
                {
                    @* The original plan next to where this payday stands now. *@
                    var change = col.LeftOver - col.PlannedLeftOver;
                    <table class="sheet-table plan-table">
                        <thead><tr><th></th><th class="text-end">Plan</th><th class="text-end">Now</th></tr></thead>
                        <tbody>
                            <tr><td>Income</td><td class="text-end money text-muted">@col.PlannedIncome.ToString("C")</td><td class="text-end money">@col.Income.ToString("C")</td></tr>
                            <tr><td>Spending</td><td class="text-end money text-muted">&minus; @col.PlannedSpending.ToString("C")</td><td class="text-end money">&minus; @col.Spending.ToString("C")</td></tr>
                        </tbody>
                        <tfoot>
                            <tr><td>Left over</td>
                                <td class="text-end money text-muted">@col.PlannedLeftOver.ToString("C")</td>
                                <td class="text-end money @(col.LeftOver < 0 ? "text-danger" : "text-success")">@col.LeftOver.ToString("C")</td></tr>
                            @if (change != 0)
                            {
                                <tr class="plan-change"><td colspan="3" class="text-end small @(change < 0 ? "text-danger" : "text-success")">
                                    @Math.Abs(change).ToString("C") @(change < 0 ? "less" : "more") than planned</td></tr>
                            }
                        </tfoot>
                    </table>
                }
                else
                {
                    <table class="sheet-table">
                        <tbody>
                            <tr><td>Income</td><td class="text-end money">@col.Income.ToString("C")</td></tr>
                            <tr><td>Spending</td><td class="text-end money">&minus; @col.Spending.ToString("C")</td></tr>
                        </tbody>
                        <tfoot>
                            <tr><td>Left over</td><td class="text-end money @(col.LeftOver < 0 ? "text-danger" : "text-success")">@col.LeftOver.ToString("C")</td></tr>
                        </tfoot>
                    </table>
                }
                @if (Model.HasPlan && !col.IsUnassigned)
                {
                    @* Where the money from this payday is now, updated as bills are marked pending and complete. *@
                    var paidPct = col.Spending > 0 ? (int)(col.Paid / col.Spending * 100) : 0;
                    var pendPct = col.Spending > 0 ? (int)(col.Pending / col.Spending * 100) : 0;
                    <div class="now-block">
                        <div class="progress my-1" role="progressbar" aria-label="Share of this payday's bills paid or pending">
                            <div class="progress-bar bg-complete" style="width:@paidPct%"></div>
                            <div class="progress-bar bg-pending" style="width:@pendPct%"></div>
                        </div>
                        <table class="sheet-table small">
                            <tbody>
                                <tr><td><span class="swatch status-complete"></span> Paid</td><td class="text-end money">@col.Paid.ToString("C")</td></tr>
                                <tr><td><span class="swatch status-pending"></span> Pending</td><td class="text-end money">@col.Pending.ToString("C")</td></tr>
                                <tr><td><span class="swatch status-notpaid"></span> Not paid yet</td><td class="text-end money">@col.StillToPay.ToString("C")</td></tr>
                                <tr class="fw-semibold"><td title="Income minus paid and pending bills">Left in the account now</td>
                                    <td class="text-end money @(col.LeftNow < 0 ? "text-danger" : "")">@col.LeftNow.ToString("C")</td></tr>
                            </tbody>
                        </table>
                    </div>
                }
                @if (!col.IsUnassigned && col.LeftOver > 0)
                {
                    var share = household.Split(col.LeftOver);
                    <table class="sheet-table split-table small">
                        <tbody>
                            <tr><td class="text-muted">Buffer (@household.BufferPercent.ToString("0.##")%)</td><td class="text-end money text-muted">@share.Buffer.ToString("C")</td></tr>
                            <tr><td>@household.FirstPartnerName</td><td class="text-end money">@share.First.ToString("C")</td></tr>
                            <tr><td>@household.SecondPartnerName</td><td class="text-end money">@share.Second.ToString("C")</td></tr>
                        </tbody>
                    </table>
                }
            </div>
        }
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card p-3 h-100">
            <form asp-action="SaveNotes" method="post">
                <fieldset @(b.IsArchived ? "disabled" : "")>
                <input type="hidden" name="id" value="@b.Id" />
                <label class="form-label" for="notes"><i class="bi bi-journal-text me-1"></i> Notes for @Model.Title</label>
                <textarea id="notes" name="notes" class="form-control" rows="3" placeholder="Anything to remember this month">@b.Notes</textarea>
                <button class="btn btn-sm btn-outline-primary mt-2 edit-only">Save notes</button>
                </fieldset>
            </form>
            <details class="mt-3 edit-only">
                <summary class="text-brand fw-medium" style="cursor:pointer"><i class="bi bi-plus-circle me-1"></i> Add other income this month</summary>
                <form asp-action="AddPaycheck" method="post" class="row g-2 mt-1">
                    <input type="hidden" name="budgetId" value="@b.Id" />
                    <div class="col-12 col-sm-5"><input name="label" placeholder="Description" class="form-control" required /></div>
                    <div class="col-6 col-sm-3"><input type="date" name="payDate" value="@Model.FirstDay.ToString("yyyy-MM-dd")" class="form-control" /></div>
                    <div class="col-6 col-sm-2"><input type="number" step="0.01" inputmode="decimal" name="amount" placeholder="Amount" class="form-control" required /></div>
                    <div class="col-12 col-sm-2 d-grid"><button class="btn btn-success">Add</button></div>
                </form>
                <div class="form-text">This adds a new column for that date, unless it's within a few days of another payday.</div>
            </details>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card p-3 h-100 d-flex flex-column gap-2 justify-content-center">
            <form asp-action="Sync" method="post" class="d-grid edit-only">
                <input type="hidden" name="id" value="@b.Id" />
                <button class="btn btn-outline-primary" title="Adds paychecks and recurring bills that are missing from this month, and puts unassigned bills under a payday. Lines already here are left alone."><i class="bi bi-arrow-repeat me-1"></i> Add missing items</button>
            </form>
            @if (!b.IsArchived)
            {
                ViewData["ResyncReturn"] = $"{b.Year}-{b.Month}";
                <partial name="_Resync" />
            }
            @if (!b.IsArchived)
            {
                <form asp-action="Archive" method="post" class="d-grid">
                    <input type="hidden" name="id" value="@b.Id" />
                    <button class="btn btn-outline-secondary" title="Hide this month from the main list and make it read-only"><i class="bi bi-archive me-1"></i> Archive this month</button>
                </form>
            }
            <form asp-action="Delete" method="post" class="d-grid" onsubmit="return confirm('Delete the whole @Model.Title budget? This cannot be undone.');">
                <input type="hidden" name="id" value="@b.Id" />
                <button class="btn btn-outline-danger"><i class="bi bi-trash3 me-1"></i> Delete this month</button>
            </form>
        </div>
    </div>
</div>

</div>

<!-- Edit or add an expense -->
<div class="modal fade" id="expenseModal" tabindex="-1" aria-labelledby="expenseModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
        <form class="modal-content" method="post" id="expenseForm" asp-action="UpdateExpense">
            <div class="modal-header">
                <h5 class="modal-title" id="expenseModalTitle">Edit expense</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="id" />
                <input type="hidden" name="budgetId" value="@b.Id" />
                <div class="mb-2"><label class="form-label">Item</label><input name="title" class="form-control" required /></div>
                <div class="mb-2"><label class="form-label">Company</label><input name="company" class="form-control" /></div>
                <div class="row g-2 mb-2">
                    <div class="col-7"><label class="form-label">Amount</label><input name="amount" type="number" step="0.01" inputmode="decimal" class="form-control" required /></div>
                    <div class="col-5"><label class="form-label">Due day</label><input name="dueDay" type="number" min="1" max="31" class="form-control" /></div>
                </div>
                <div class="mb-2">
                    <label class="form-label">Paid from</label>
                    <select name="payPeriodId" class="form-select">
                        @foreach (var col in payColumns)
                        {
                            <option value="@col.TargetPayPeriodId" data-all="@string.Join(",", col.Paychecks.Select(p => p.Id))">@col.Heading</option>
                        }
                        <option value="">Not assigned</option>
                    </select>
                </div>
                <div class="row g-2">
                    <div class="col-7">
                        <label class="form-label">Category</label>
                        <select name="categoryId" class="form-select">
                            @foreach (var c in Model.Categories) { <option value="@c.Id">@c.Name</option> }
                        </select>
                    </div>
                    <div class="col-5">
                        <label class="form-label">Status</label>
                        <select name="status" class="form-select">
                            <option value="NotPaid">Not paid</option>
                            <option value="Pending">Pending</option>
                            <option value="Complete">Complete</option>
                        </select>
                    </div>
                </div>
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" role="switch" name="isFixed" value="true" id="expenseFixed" />
                    <label class="form-check-label" for="expenseFixed">Fixed to this payday</label>
                </div>
                <div class="form-check form-switch mt-2" id="forwardGroup">
                    <input class="form-check-input" type="checkbox" role="switch" name="applyForward" value="true" id="expenseForward" checked />
                    <label class="form-check-label" for="expenseForward" id="forwardLabel">Also change the ones after this</label>
                </div>
                <div class="form-text mt-2" id="expenseNote"></div>
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-outline-danger me-auto" id="expenseDelete" formaction="@Url.Action("DeleteExpense")"
                        formnovalidate onclick="return confirm('Remove this item from @Model.Title?');">Remove</button>
                <button type="button" class="btn btn-link" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
        </form>
    </div>
</div>

<!-- Edit a paycheck -->
<div class="modal fade" id="payModal" tabindex="-1" aria-labelledby="payModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
        <form class="modal-content" method="post" asp-action="UpdatePaycheck">
            <div class="modal-header">
                <h5 class="modal-title" id="payModalTitle">Edit paycheck</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="id" />
                <div class="mb-2"><label class="form-label">Take-home this month</label><input name="baseAmount" type="number" step="0.01" inputmode="decimal" class="form-control" required /></div>
                <div class="mb-2"><label class="form-label">Payday</label><input name="payDate" type="date" class="form-control" required /></div>
                <div class="form-text">Use "+ extra" on the Income section to add a bonus without changing the regular amount.</div>
                <hr />
                <div class="form-label mb-1">Budget this paycheck in another month</div>
                <div class="form-text mt-0 mb-2">For a check that pays the next month's bills, like an October 31 check that covers November. The unpaid bills due before the next payday come along with it.</div>
                <input type="hidden" name="offset" value="1" id="moveOffset" />
                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-sm btn-outline-secondary" formaction="@Url.Action("MovePaycheck")" formnovalidate
                            onclick="document.getElementById('moveOffset').value='-1'"><i class="bi bi-arrow-left"></i> Move to @Model.Previous.ToString("MMMM")</button>
                    <button type="submit" class="btn btn-sm btn-outline-primary" formaction="@Url.Action("MovePaycheck")" formnovalidate
                            onclick="document.getElementById('moveOffset').value='1'">Move to @Model.Next.ToString("MMMM") <i class="bi bi-arrow-right"></i></button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-outline-danger me-auto" formaction="@Url.Action("DeletePaycheck")" formnovalidate
                        onclick="return confirm('Remove this paycheck from @Model.Title? Its bills move to Not assigned.');">Remove paycheck</button>
                <button type="button" class="btn btn-link" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
        </form>
    </div>
</div>

<!-- Add extra money to a paycheck -->
