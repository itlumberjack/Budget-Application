<!-- AI helper: suggests moving unpaid bills between paydays -->
<div class="modal fade" id="aiModal" tabindex="-1" aria-labelledby="aiModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-lg modal-fullscreen-sm-down">
        <form class="modal-content" asp-action="ApplyArrangement" method="post" id="aiForm">
            <input type="hidden" name="id" value="@b.Id" />
            <div class="modal-header">
                <h2 class="modal-title h5" id="aiModalTitle"><i class="bi bi-stars text-ai me-1" id="aiModalIcon"></i> <span>Suggested arrangement</span></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="aiLoading" class="text-center py-4">
                    <div class="spinner-border text-ai" role="status"></div>
                    <p class="text-muted mt-3 mb-0">Looking over @Model.Title's paydays and bills...</p>
                </div>
                <div id="aiError" class="alert alert-warning d-none mb-0"></div>
                <div id="aiResult" class="d-none">
                    <p id="aiSummary" class="mb-3"></p>
                    <div id="aiMoves" class="list-group mb-3"></div>
                    <h3 class="h6 text-muted">Left over per payday</h3>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-1">
                            <thead><tr><th>Payday</th><th class="text-end">Now</th><th class="text-end">After</th></tr></thead>
                            <tbody id="aiColumns"></tbody>
                        </table>
                    </div>
                    <p class="small text-muted mb-0">Nothing changes until you apply. Uncheck any move you don't want.</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link" data-bs-dismiss="modal">Close</button>
                <button type="submit" class="btn btn-primary" id="aiApply" disabled>Apply selected</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const sheet = document.getElementById('sheet');

        // Payday pills scroll that column into view.
        document.getElementById('paydayPills').addEventListener('click', e => {
            const btn = e.target.closest('[data-jump]');
            if (!btn) return;
            const target = sheet.querySelectorAll('.sheet-heading')[+btn.dataset.jump];
            sheet.scrollTo({ left: target.offsetLeft - 16, behavior: 'smooth' });
        });

        // Sections with nothing in them this month are hidden until "Show empty sections" is on.
        const showEmpty = document.getElementById('showEmpty');
        try { showEmpty.checked = localStorage.getItem('budget.showEmpty') === '1'; } catch { }
        const applyEmpty = () => {
            document.getElementById('sheetGrid').classList.toggle('hide-empty', !showEmpty.checked);
            try { localStorage.setItem('budget.showEmpty', showEmpty.checked ? '1' : '0'); } catch { }
        };
        showEmpty.addEventListener('change', applyEmpty);
        applyEmpty();

        // ----- Changes without a full page load -----
        // Status changes and drags post as usual; the server answers with the updated month page, and only the
        // totals, payday pills and sheet are swapped in, so the page doesn't flash or lose its scroll position.
        let pending = Promise.resolve(), queued = 0;
        const refreshFrom = async res => {
            const html = await res.text();
            const page = new DOMParser().parseFromString(html, 'text/html');
            const fresh = page.getElementById('sheet');
            if (!res.ok || !fresh) { location.reload(); return; }
            document.getElementById('monthTotals').innerHTML = page.getElementById('monthTotals').innerHTML;
            document.getElementById('paydayPills').innerHTML = page.getElementById('paydayPills').innerHTML;
            const left = sheet.scrollLeft;
            sheet.innerHTML = fresh.innerHTML;
            sheet.scrollLeft = left;
            applyEmpty();
            const error = page.querySelector('.alert-danger');
            if (error) showError(error.querySelector('div').textContent);
        };
        const send = form => {
            const body = new FormData(form);
            queued++;
            // One request at a time, in click order; only the last answer is drawn.
            pending = pending.then(async () => {
                try {
                    const res = await fetch(form.action, { method: 'POST', body });
                    if (--queued === 0) await refreshFrom(res);
                } catch {
                    queued = 0;
                    location.reload();
                }
            });
        };
        const showError = message => {
            const box = document.createElement('div');
            box.className = 'alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2';
            box.setAttribute('role', 'alert');
            box.innerHTML = '<i class="bi bi-exclamation-triangle-fill"></i><div></div><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>';
            box.querySelector('div').textContent = message;
            document.getElementById('liveAlerts').replaceChildren(box);
        };

        // The status dot: show the next status straight away, then save it.
        const statuses = ['NotPaid', 'Pending', 'Complete'];
        const names = { NotPaid: 'Not paid', Pending: 'Pending', Complete: 'Complete' };
        // The dot has its own job; don't also open the edit dialog. Bootstrap opens dialogs from a capturing
        // listener on the document, so this has to stop the click earlier, on the window.
        window.addEventListener('click', e => {
            if (e.target.closest?.('#sheet .status-cell')) e.stopPropagation();
        }, true);
        sheet.addEventListener('submit', e => {
            const form = e.target.closest('.status-cell form');
            if (!form) return;
            e.preventDefault();
            const row = form.closest('tr');
            const status = form.elements['status'].value;
            const next = statuses[(statuses.indexOf(status) + 1) % 3];
            row.classList.remove('status-notpaid', 'status-pending', 'status-complete');
            row.classList.add('status-' + status.toLowerCase());
            row.dataset.status = status;
            form.querySelector('.status-dot').title = `${names[status]} (click for ${names[next]})`;
            send(form);
            form.elements['status'].value = next; // a quick second click moves on to the one after
        });

        // Drag a bill to another payday. Paydays it can't go to (after its due date) are dimmed.
        let dragged = null;
        const blocks = () => sheet.querySelectorAll('[data-col]');
        sheet.addEventListener('dragstart', e => {
            const row = e.target.closest('tr[draggable=true]');
            if (!row) return;
            dragged = row;
            const ok = row.dataset.targets.split(',');
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', row.dataset.title);
            requestAnimationFrame(() => {
                row.classList.add('dragging');
                blocks().forEach(el => el.classList.add(ok.includes(el.dataset.col) ? 'drop-ok' : 'drop-no'));
            });
        });
        const endDrag = () => {
            dragged?.classList.remove('dragging');
            dragged = null;
            blocks().forEach(el => el.classList.remove('drop-ok', 'drop-no', 'drop-over'));
        };
        sheet.addEventListener('dragend', endDrag);
        const target = e => {
            const block = e.target.closest('[data-col]');
            return dragged && block && dragged.dataset.targets.split(',').includes(block.dataset.col) ? block : null;
        };
        sheet.addEventListener('dragover', e => {
            const block = target(e);
            if (!block) return;
            e.preventDefault();
            e.dataTransfer.dropEffect = 'move';
            blocks().forEach(el => el.classList.toggle('drop-over', el.dataset.col === block.dataset.col));
        });
        sheet.addEventListener('drop', e => {
            const block = target(e);
            if (!block) return;
            e.preventDefault();
            const heading = sheet.querySelector(`.sheet-heading[data-col="${block.dataset.col}"]`);
            const form = document.getElementById('moveForm');
            form.elements['id'].value = dragged.dataset.id;
            form.elements['payPeriodId'].value = heading.dataset.payTarget;
            dragged.classList.add('moving');
            endDrag();
            send(form);
        });

        const expenseModal = document.getElementById('expenseModal');
        expenseModal.addEventListener('show.bs.modal', e => {
            const d = e.relatedTarget.dataset;
            const form = document.getElementById('expenseForm');
            const isAdd = d.mode === 'add';
            form.action = isAdd ? '@Url.Action("AddExpense")' : '@Url.Action("UpdateExpense")';
            document.getElementById('expenseModalTitle').textContent = isAdd ? 'Add an expense' : 'Edit expense';
            document.getElementById('expenseDelete').style.display = isAdd ? 'none' : '';
            form.elements['id'].value = isAdd ? '' : d.id;
            form.elements['title'].value = isAdd ? '' : d.title;
            form.elements['company'].value = isAdd ? '' : (d.company || '');
            form.elements['amount'].value = isAdd ? '' : d.amount;
            form.elements['dueDay'].value = isAdd ? '' : (d.due || '');
            form.elements['categoryId'].value = d.category;
            form.elements['status'].value = isAdd ? 'NotPaid' : d.status;
            form.elements['isFixed'].checked = !isAdd && d.fixed === '1';
            // Recurring bills and shares of the extra debt payment can carry a change on to later months.
            const kind = isAdd ? '' : d.kind;
            document.getElementById('forwardGroup').hidden = !kind;
            form.elements['applyForward'].checked = kind === 'recurring';
            const forwardNote = {
                recurring: 'On: the bill on Bills & Expenses and its unpaid copies after this one (later this month for weekly bills, and in later months) change too. Off: this one only.',
                snowball: "On: this month's new extra total becomes the monthly extra on Debt Payoff, spread over later months' paydays."
            };
            const offNote = { snowball: "A new amount here: the other paydays in @Model.Title make up the difference, so the month still pays the extra set on Debt Payoff." };
            const showNote = () => document.getElementById('expenseNote').textContent = !kind
                ? 'Changes apply to @Model.Title only.'
                : form.elements['applyForward'].checked ? forwardNote[kind] : (offNote[kind] || 'Changes apply to @Model.Title only.');
            form.elements['applyForward'].onchange = showNote;
            showNote();
            // A column can hold more than one paycheck; select the column that holds this bill's paycheck.
            const pay = d.pay || '';
            const option = [...form.elements['payPeriodId'].options].find(o => o.value === pay || (o.dataset.all || '').split(',').includes(pay));
            form.elements['payPeriodId'].value = option ? option.value : '';
        });
        expenseModal.addEventListener('shown.bs.modal', () => document.getElementById('expenseForm').elements['title'].focus());

        document.getElementById('payModal').addEventListener('show.bs.modal', e => {
            const d = e.relatedTarget.dataset;
            const form = e.target.querySelector('form');
            form.elements['id'].value = d.id;
            form.elements['baseAmount'].value = d.amount;
            form.elements['payDate'].value = d.date;
            document.getElementById('payModalTitle').textContent = 'Edit ' + d.label;
        });

        document.getElementById('extraModal').addEventListener('show.bs.modal', e => {
            const first = (e.relatedTarget.dataset.payIds || '').split(',')[0];
            if (first) e.target.querySelector('select[name=payPeriodId]').value = first;
        });
        // "Even out" and the AI helper share one dialog: each button names where its suggestion comes from.
        const aiForm = document.getElementById('aiForm');
        const money = n => n.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
        const nth = d => d + ([, 'st', 'nd', 'rd'][d % 100 >> 3 ^ 1 && d % 10] || 'th');
        const esc = t => { const d = document.createElement('div'); d.textContent = t; return d.innerHTML; };
        document.getElementById('aiModal').addEventListener('show.bs.modal', async e => {
            const source = e.relatedTarget.dataset;
            document.querySelector('#aiModalTitle span').textContent = source.title;
            document.getElementById('aiModalIcon').className = `bi ${source.icon} text-ai me-1`;
            const show = id => ['aiLoading', 'aiError', 'aiResult'].forEach(x => document.getElementById(x).classList.toggle('d-none', x !== id));
            const apply = document.getElementById('aiApply');
            show('aiLoading');
            apply.disabled = true;
            try {
                const res = await fetch(source.url, { method: 'POST', body: new FormData(aiForm) });
                const data = await res.json();
                if (data.error) throw new Error(data.error);
                document.getElementById('aiSummary').textContent = data.summary;
                document.getElementById('aiMoves').innerHTML = data.moves.length
                    ? data.moves.map(m => `
                        <label class="list-group-item d-flex gap-3 align-items-start">
                            <input class="form-check-input flex-shrink-0 mt-1" type="checkbox" name="moves" value="${m.expenseId}:${m.toPayPeriodId}" checked>
                            <span class="flex-grow-1">
                                <span class="d-flex justify-content-between gap-2"><strong>${esc(m.title)}</strong><span class="money">${money(m.amount)}</span></span>
                                <span class="d-block small">${esc(m.from)} <i class="bi bi-arrow-right"></i> <strong>${esc(m.to)}</strong>${m.dueDay ? ` &middot; due the ${nth(m.dueDay)}` : ''}</span>
                                <span class="d-block small text-muted">${esc(m.reason)}</span>
                            </span>
                        </label>`).join('')
                    : '<div class="list-group-item text-muted"><i class="bi bi-check2-circle text-success me-1"></i> No moves needed. This month already works.</div>';
                document.getElementById('aiColumns').innerHTML = data.columns.map(c => `
                    <tr><td>${esc(c.heading)}</td>
                        <td class="text-end money ${c.before < 0 ? 'text-danger' : ''}">${money(c.before)}</td>
                        <td class="text-end money fw-semibold ${c.after < 0 ? 'text-danger' : 'text-success'}">${money(c.after)}</td></tr>`).join('');
                apply.disabled = data.moves.length === 0;
                show('aiResult');
            } catch (err) {
                document.getElementById('aiError').textContent = err.message || 'Something went wrong. Try again.';
                show('aiError');
            }
        });
        aiForm.addEventListener('change', () =>
            document.getElementById('aiApply').disabled = !aiForm.querySelector('input[name=moves]:checked'));
    </script>
}
