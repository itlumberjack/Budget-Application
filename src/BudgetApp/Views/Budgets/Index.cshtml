@model List<MonthSummary>
@{
    ViewData["Title"] = "Monthly Budgets";
    var today = DateTime.Today;
    var existing = Model.Select(m => (m.Year, m.Month)).ToHashSet();
    var hasIncome = (bool)ViewBag.HasIncome;
    var hasDebts = (bool)ViewBag.HasDebts;
}

<div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-3">
    <div>
        <h1 class="mb-1">Monthly Budgets</h1>
        <p class="page-subtitle mb-0">Pick a month to see every paycheck and bill side by side.</p>
    </div>
    <form asp-action="Go" method="get" class="d-flex gap-2">
        <input type="month" name="month" class="form-control" value="@today.ToString("yyyy-MM")" aria-label="Pick a month" />
        <button class="btn btn-primary text-nowrap"><i class="bi bi-box-arrow-in-right"></i> Open</button>
    </form>
</div>

@if (!hasIncome || !hasDebts)
{
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h5 mb-3"><i class="bi bi-stars text-brand me-1"></i> Let's get set up</h2>
            <div class="row g-3">
                <div class="col-md-4">
                    <a asp-controller="Income" asp-action="Index" class="d-flex gap-3 text-decoration-none text-body">
                        <span class="stat-icon icon-income flex-shrink-0"><i class="bi @(hasIncome ? "bi-check-lg" : "bi-1-circle")"></i></span>
                        <span><span class="fw-semibold d-block @(hasIncome ? "text-decoration-line-through text-muted" : "")">Add your paychecks</span><span class="item-meta">Take-home pay and how often it comes.</span></span>
                    </a>
                </div>
                <div class="col-md-4">
                    <a asp-controller="RecurringDebts" asp-action="Index" class="d-flex gap-3 text-decoration-none text-body">
                        <span class="stat-icon icon-spend flex-shrink-0"><i class="bi @(hasDebts ? "bi-check-lg" : "bi-2-circle")"></i></span>
                        <span><span class="fw-semibold d-block @(hasDebts ? "text-decoration-line-through text-muted" : "")">Add your monthly bills</span><span class="item-meta">Mortgage, power, car payment and so on.</span></span>
                    </a>
                </div>
                <div class="col-md-4">
                    <div class="d-flex gap-3">
                        <span class="stat-icon icon-left flex-shrink-0"><i class="bi bi-3-circle"></i></span>
                        <span><span class="fw-semibold d-block">Open a month</span><span class="item-meta">It fills in from your paychecks and bills.</span></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<h2 class="h6 text-uppercase text-muted fw-semibold mb-2">Coming up</h2>
<div class="row g-2 mb-4">
    @for (var i = 0; i < 4; i++)
    {
        var d = today.AddMonths(i);
        var made = existing.Contains((d.Year, d.Month));
        <div class="col-6 col-md-3">
            <a class="card month-card position-relative p-3 h-100 @(i == 0 ? "bg-brand-soft" : "")" href="@Url.RouteUrl("month", new { year = d.Year, month = d.Month })">
                <div class="fw-semibold">@d.ToString("MMMM")</div>
                <div class="item-meta">@d.Year &middot; @(made ? "Open budget" : "Ready to view")</div>
                <i class="bi @(made ? "bi-arrow-right-circle-fill text-brand" : "bi-arrow-right-circle text-muted") position-absolute top-0 end-0 m-3 fs-5"></i>
            </a>
        </div>
    }
</div>

@{
    var open = Model.Where(m => !m.IsArchived).ToList();
    var archived = Model.Where(m => m.IsArchived).OrderByDescending(m => m.Year).ThenByDescending(m => m.Month).ToList();
}
<h2 class="h6 text-uppercase text-muted fw-semibold mb-2">All months</h2>
@if (open.Count == 0)
{
    <div class="card empty-state">
        <i class="bi bi-calendar3"></i>
        <p class="mt-2 mb-0 text-muted">No budgets yet. Pick a month above and it builds itself from your paychecks and bills.</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var m in open.OrderBy(m => m.Year).ThenBy(m => m.Month))
        {
            var pct = m.Expenses > 0 ? (int)(m.Complete / m.Expenses * 100) : 0;
            <div class="col-sm-6 col-lg-4">
                <a class="card month-card p-3 h-100" href="@Url.RouteUrl("month", new { year = m.Year, month = m.Month })">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="fw-semibold fs-5">@m.Title</div>
                        <span class="badge rounded-pill @(m.Remaining < 0 ? "text-bg-danger" : "text-bg-success")">@(m.Remaining < 0 ? "Over" : "On track")</span>
                    </div>
                    <div class="d-flex justify-content-between mt-2 small">
                        <span class="text-muted">Income</span><span class="money">@m.Income.ToString("C")</span>
                    </div>
                    <div class="d-flex justify-content-between small">
                        <span class="text-muted">Planned</span><span class="money">@m.Expenses.ToString("C")</span>
                    </div>
                    <div class="d-flex justify-content-between small fw-semibold">
                        <span>Left over</span><span class="money @(m.Remaining < 0 ? "text-danger" : "text-success")">@m.Remaining.ToString("C")</span>
                    </div>
                    <div class="progress mt-2" title="@pct% of bills complete"><div class="progress-bar" style="width:@pct%; background: var(--status-complete)"></div></div>
                    <div class="item-meta mt-1">@pct% of bills complete</div>
                </a>
            </div>
        }
    </div>
}

@if (archived.Count > 0)
{
    <details class="mt-4">
        <summary class="h6 text-uppercase text-muted fw-semibold"><i class="bi bi-archive me-1"></i> Archive (@archived.Count)</summary>
        <p class="item-meta mt-2">Months that are over. They're read-only; open one and choose Unarchive to change it.</p>
        <div class="list-group">
            @foreach (var m in archived)
            {
                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href="@Url.RouteUrl("month", new { year = m.Year, month = m.Month })">
                    <span class="fw-semibold">@m.Title</span>
                    <span class="small">
                        <span class="text-muted">Left over</span>
                        <span class="money ms-1 @(m.Remaining < 0 ? "text-danger" : "text-success")">@m.Remaining.ToString("C")</span>
                    </span>
                </a>
            }
        </div>
    </details>
}
