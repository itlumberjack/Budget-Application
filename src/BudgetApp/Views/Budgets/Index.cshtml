@model List<MonthSummary>
@{
    ViewData["Title"] = "Monthly Budgets";
    var today = DateTime.Today;
    var existing = Model.Select(m => (m.Year, m.Month)).ToHashSet();
}

<h1 class="mb-3">Monthly Budgets</h1>

@if (!(bool)ViewBag.HasIncome || !(bool)ViewBag.HasDebts)
{
    <div class="alert alert-info">
        <strong>Getting started:</strong>
        <ol class="mb-0">
            <li class="@((bool)ViewBag.HasIncome ? "text-decoration-line-through" : "")">Enter your take-home pay and pay schedules on <a asp-controller="Income" asp-action="Index">Pay &amp; Schedule</a>.</li>
            <li class="@((bool)ViewBag.HasDebts ? "text-decoration-line-through" : "")">Add your monthly bills on <a asp-controller="RecurringDebts" asp-action="Index">Recurring Debts</a>.</li>
            <li>Open a month below. It fills in automatically from your paychecks and bills.</li>
        </ol>
    </div>
}

<div class="d-flex flex-wrap gap-2 mb-4">
    @for (var i = 0; i < 4; i++)
    {
        var d = today.AddMonths(i);
        <a class="btn @(existing.Contains((d.Year, d.Month)) ? "btn-primary" : "btn-outline-primary")"
           href="@Url.RouteUrl("month", new { year = d.Year, month = d.Month })">@d.ToString("MMMM yyyy")</a>
    }
    <form asp-action="Go" method="get" class="d-flex gap-2 ms-auto">
        <input type="month" name="month" class="form-control" value="@today.ToString("yyyy-MM")" aria-label="Pick a month" />
        <button class="btn btn-outline-secondary">Open</button>
    </form>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">No months yet. Pick one above to create it.</p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr><th>Month</th><th class="text-end">Income</th><th class="text-end">Planned spending</th><th class="text-end">Complete</th><th class="text-end">Left over</th></tr>
        </thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td><a href="@Url.RouteUrl("month", new { year = m.Year, month = m.Month })">@m.Title</a></td>
                    <td class="text-end money">@m.Income.ToString("C")</td>
                    <td class="text-end money">@m.Expenses.ToString("C")</td>
                    <td class="text-end money">@m.Complete.ToString("C")</td>
                    <td class="text-end money @(m.Remaining < 0 ? "text-danger fw-bold" : "text-success")">@m.Remaining.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
}
