@model BudgetApp.Services.StubFindings
@{
    var income = (IncomeSource)ViewBag.Income;
    var upcoming = (int)ViewBag.Upcoming;
    ViewData["Title"] = $"Check stub for {income.Name}";
    string Money(decimal? v) => v is decimal d ? d.ToString("C") : "—";
    var groups = new[]
    {
        (Kind: StubLineKind.Earnings, Title: "Earnings", Sign: ""),
        (Kind: StubLineKind.PreTaxDeduction, Title: "Before-tax deductions", Sign: "−"),
        (Kind: StubLineKind.Tax, Title: "Taxes", Sign: "−"),
        (Kind: StubLineKind.AfterTaxDeduction, Title: "After-tax deductions", Sign: "−")
    };
    var index = 0;
}

<div class="mx-auto" style="max-width:40rem">
<a asp-action="Index" class="small text-decoration-none"><i class="bi bi-chevron-left"></i> Back to Pay &amp; Schedule</a>
<h1 class="mt-1 mb-1">@ViewData["Title"]</h1>
<p class="text-muted mb-3">
    @(Model.Employer ?? income.Name)@(Model.PayDate is DateTime pd ? $" · paid {pd:MMMM d, yyyy}" : "")@(Model.PeriodStart is DateTime ps && Model.PeriodEnd is DateTime pe ? $" · for {ps:MMM d} to {pe:MMM d}" : "")
</p>

@if (!string.IsNullOrWhiteSpace(Model.Summary))
{
    <div class="alert alert-info d-flex gap-2" id="stubSummary"><i class="bi bi-stars"></i><div>@Model.Summary</div></div>
}

<form asp-action="ApplyStub" method="post" class="card"><div class="card-body p-3 p-md-4">
    <input type="hidden" name="id" value="@income.Id" />
    <input type="hidden" name="payDate" value="@Model.PayDate?.ToString("yyyy-MM-dd")" />
    <input type="hidden" name="employer" value="@Model.Employer" />
    <input type="hidden" name="gross" value="@Model.Gross?.ToString("0.00")" />

    <table class="table table-sm align-middle mb-3" id="stubBreakdown">
        <tbody>
            <tr class="fw-semibold"><td>Gross pay</td><td class="text-end money">@Money(Model.Gross)</td><td class="text-end small text-muted">this year</td></tr>
            @foreach (var g in groups)
            {
                var lines = Model.Lines.Where(l => l.Kind == g.Kind).ToList();
                if (lines.Count == 0) { continue; }
                <tr class="table-group" data-kind="@g.Kind"><td colspan="3" class="small text-uppercase text-muted pt-3">@g.Title <span class="float-end">@g.Sign@Model.Total(g.Kind).ToString("C")</span></td></tr>
                foreach (var l in lines)
                {
                    <tr data-line="@l.Name">
                        <td class="ps-3">@l.Name
                            <input type="hidden" name="lines[@index].Kind" value="@l.Kind" />
                            <input type="hidden" name="lines[@index].Name" value="@l.Name" />
                            <input type="hidden" name="lines[@index].Amount" value="@l.Amount.ToString("0.00")" />
                            <input type="hidden" name="lines[@index].YearToDate" value="@l.YearToDate?.ToString("0.00")" /></td>
                        <td class="text-end money">@g.Sign@l.Amount.ToString("C")</td>
                        <td class="text-end small text-muted money">@Money(l.YearToDate)</td>
                    </tr>
                    index++;
                }
            }
            <tr class="fw-semibold border-top"><td class="pt-3">Take-home pay</td><td class="text-end money pt-3">@Money(Model.Net)</td><td></td></tr>
        </tbody>
    </table>
    @if (Model.Worked is decimal worked && Model.Net is decimal n && !Model.AddsUp)
    {
        <div class="alert alert-warning small" id="stubMismatch"><i class="bi bi-exclamation-triangle me-1"></i>
            Gross less these taxes and deductions is @worked.ToString("C"), not @n.ToString("C"). The AI may have missed or misread a line, so check the stub before saving.</div>
    }

    <div class="form-check mb-2">
        <input class="form-check-input" type="checkbox" name="useNet" value="true" id="useNet" checked="@(Model.Net is decimal net && net > 0 && net != income.TakeHomeAmount)" disabled="@(Model.Net is null)" />
        <label class="form-check-label fw-medium" for="useNet">Use this as @income.Name's take-home pay</label>
        <div class="d-flex align-items-center gap-2 mt-1">
            <div class="input-group input-group-sm" style="max-width:12rem"><span class="input-group-text">$</span><input class="form-control" name="net" type="number" step="0.01" value="@Model.Net?.ToString("0.00")" /></div>
            <span class="small text-muted">now @income.TakeHomeAmount.ToString("C")</span>
        </div>
    </div>
    <div class="form-check mb-3 ms-4">
        <input class="form-check-input" type="checkbox" name="updateBuilt" value="true" id="updateBuilt" checked />
        <label class="form-check-label" for="updateBuilt">Also change @(upcoming == 1 ? "the 1 upcoming payday" : $"the {upcoming} upcoming paydays") in months already built</label>
        <div class="form-text">Off: only months built from now on use the new amount.</div>
    </div>
    <p class="small text-muted">The breakdown is kept on Pay &amp; Schedule. The file itself isn't saved.</p>

    <div class="d-flex gap-2">
        <button class="btn btn-primary"><i class="bi bi-check-lg"></i> Save to @income.Name</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</div></form>
</div>
