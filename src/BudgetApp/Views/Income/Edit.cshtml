@model IncomeSource
@{
    ViewData["Title"] = Model.Id == 0 ? "Add a paycheck" : $"Edit {Model.Name}";
}

<div class="mx-auto" style="max-width:36rem">
<a asp-action="Index" class="small text-decoration-none"><i class="bi bi-chevron-left"></i> Back</a>
<h1 class="mt-1 mb-3">@ViewData["Title"]</h1>
<div class="card"><div class="card-body p-3 p-md-4">

<form asp-action="Save" method="post" >
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" placeholder="e.g. Brad's paycheck" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TakeHomeAmount" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">$</span>
            <input asp-for="TakeHomeAmount" class="form-control" step="0.01" type="number" inputmode="decimal" />
        </div>
        <span asp-validation-for="TakeHomeAmount" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Frequency" class="form-label"></label>
        <select asp-for="Frequency" asp-items="Html.GetEnumSelectList<PayFrequency>()" class="form-select" id="frequency"></select>
    </div>
    <div class="mb-3" id="anchor-group">
        <label asp-for="AnchorDate" class="form-label"></label>
        <input asp-for="AnchorDate" type="date" class="form-control" />
        <div class="form-text">Any past or upcoming payday. The app counts forward and back from it.</div>
        <span asp-validation-for="AnchorDate" class="text-danger"></span>
    </div>
    <div class="mb-3" id="day-group">
        <label asp-for="DayOfMonth" class="form-label"></label>
        <input asp-for="DayOfMonth" class="form-control" placeholder="Leave empty for the last day of the month" />
        <span asp-validation-for="DayOfMonth" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="CountsTowardNextMonth" class="form-check-input" />
        <label asp-for="CountsTowardNextMonth" class="form-check-label"></label>
        <div class="form-text">Turn this on for end-of-month pay that covers next month's bills. A September 30 paycheck then shows up in October's budget.</div>
    </div>
    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label"></label>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button class="btn btn-primary px-4"><i class="bi bi-check-lg"></i> Save</button>
        <a asp-action="Index" class="btn btn-light border">Cancel</a>
    </div>
</form>
</div></div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Show only the fields that matter for the chosen schedule.
        const freq = document.getElementById('frequency');
        function toggle() {
            const v = freq.value;
            const needsAnchor = v === '1' || v === '2';
            document.getElementById('anchor-group').style.display = needsAnchor ? '' : 'none';
            document.getElementById('AnchorDate').required = needsAnchor;
            document.getElementById('day-group').style.display = v === '4' ? '' : 'none';
        }
        freq.addEventListener('change', toggle);
        toggle();
    </script>
}
