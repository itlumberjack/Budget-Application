@model List<IncomeSource>
@{
    ViewData["Title"] = "Pay & Schedule";
    var today = DateTime.Today;
}

<div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-3">
    <div>
        <h1 class="mb-1">Pay &amp; Schedule</h1>
        <p class="page-subtitle mb-0">Each person's take-home pay and when it arrives.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add a paycheck</a>
</div>

@{
    var rules = (BudgetRules)ViewBag.Rules;
}
<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5 mb-1"><i class="bi bi-sliders text-brand me-1"></i> Brad's rule</h2>
        <p class="item-meta mb-3">Decide which month a paycheck near the end of the month pays for. Changes apply to this month and every month after; past months stay as they are.</p>
        <form asp-action="SaveRules" method="post" id="rulesForm">
            <div class="form-check form-switch mb-2">
                <input class="form-check-input" type="checkbox" role="switch" id="rule1" name="endOfMonthPayGoesToNextMonth" value="true"
                       @(rules.EndOfMonthPayGoesToNextMonth ? "checked" : "") onchange="this.form.submit()" />
                <label class="form-check-label fw-medium" for="rule1">End-of-month paychecks pay next month's bills</label>
                <div class="item-meta">Monthly pay that lands on the last day of the month (like October 31) goes in the next month's budget.</div>
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="rule2" name="weeklyClosestToFirstStartsMonth" value="true"
                       @(rules.WeeklyClosestToFirstStartsMonth ? "checked" : "") onchange="this.form.submit()" />
                <label class="form-check-label fw-medium" for="rule2">Weekly payday closest to the 1st starts the month</label>
                <div class="item-meta">If October 30 is closer to November 1 than November 6 is, the October 30 check goes in November's budget. On a tie, the earlier payday wins.</div>
            </div>
            <noscript><button class="btn btn-sm btn-primary mt-2">Save rules</button></noscript>
        </form>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="card empty-state">
        <i class="bi bi-wallet2"></i>
        <h2 class="h5 mt-2">No paychecks yet</h2>
        <p class="text-muted">Add each paycheck once. Every month's budget picks them up automatically.</p>
        <div><a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add a paycheck</a></div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var s in Model)
        {
            var next = BudgetApp.Services.PaySchedule.PaydaysInMonth(s, today.Year, today.Month)
                .Concat(BudgetApp.Services.PaySchedule.PaydaysInMonth(s, today.AddMonths(1).Year, today.AddMonths(1).Month))
                .Where(d => d >= today).Cast<DateTime?>().FirstOrDefault();
            <div class="col-md-6">
                <div class="card h-100 @(s.IsActive ? "" : "opacity-75")">
                    <div class="card-body d-flex gap-3">
                        <span class="stat-icon icon-income flex-shrink-0" style="width:2.6rem;height:2.6rem"><i class="bi bi-person-fill fs-5"></i></span>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="item-title fs-5">@s.Name @if (!s.IsActive) { <span class="badge text-bg-secondary align-middle">inactive</span> }</div>
                                <div class="fs-5 fw-bold money">@s.TakeHomeAmount.ToString("C")</div>
                            </div>
                            <div class="item-meta">
                                <i class="bi bi-calendar-event me-1"></i>@Html.DisplayFor(_ => s.Frequency)@(s.Frequency == PayFrequency.Monthly ? (s.DayOfMonth is int d ? $" on day {d}" : " on the last day") : "")
                                @if (s.CountsTowardNextMonth) { <span class="badge bg-brand-soft text-brand ms-1">counts toward next month</span> }
                            </div>
                            @if (next is DateTime n)
                            {
                                <div class="item-meta"><i class="bi bi-arrow-right-short"></i>Next payday @n.ToString("dddd, MMM d")</div>
                            }
                            <div class="d-flex gap-2 mt-2">
                                <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i> Edit</a>
                                <form asp-action="Delete" asp-route-id="@s.Id" method="post" onsubmit="return confirm('Delete this paycheck? Months already created keep their paychecks.');">
                                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash3"></i> Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
