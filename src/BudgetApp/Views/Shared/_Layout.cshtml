@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var nav = new[]
    {
        (Controller: "Budgets", Label: "Budgets", Long: "Monthly Budgets", Icon: "bi-calendar3"),
        (Controller: "Income", Label: "Pay", Long: "Pay & Schedule", Icon: "bi-wallet2"),
        (Controller: "RecurringDebts", Label: "Bills", Long: "Recurring Debts", Icon: "bi-arrow-repeat"),
        (Controller: "Debt", Label: "Debt", Long: "Debt Payoff", Icon: "bi-graph-down-arrow"),
        (Controller: "Categories", Label: "Categories", Long: "Categories", Icon: "bi-tags")
    };
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f2f2d" />
    <script>
        // Dark unless light was picked with the header button (see site.js). Runs before the page draws so it doesn't flash.
        try { if (localStorage.getItem('budget.theme') === 'light') document.documentElement.dataset.bsTheme = 'light'; } catch { }
    </script>
    <title>@ViewData["Title"] - Family Budget</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BudgetApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header mb-4">
        <nav class="navbar navbar-expand-md navbar-dark">
            <div class="@(ViewData["Wide"] is true ? "container-fluid px-md-4" : "container")">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark"><i class="bi bi-piggy-bank-fill"></i></span>
                    <span class="fw-semibold">Family Budget</span>
                </a>
                <ul class="navbar-nav ms-auto d-none d-md-flex gap-1">
                    @foreach (var item in nav)
                    {
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill @(controller == item.Controller ? "active" : "")" asp-controller="@item.Controller" asp-action="Index">
                                <i class="bi @item.Icon me-1"></i>@item.Long
                            </a>
                        </li>
                    }
                </ul>
                <button type="button" class="btn theme-toggle icon-btn rounded-circle ms-auto ms-md-2" id="themeToggle" title="Switch between dark and light" aria-label="Switch between dark and light">
                    <i class="bi bi-sun"></i><i class="bi bi-moon-stars"></i>
                </button>
            </div>
        </nav>
    </header>

    <div class="@(ViewData["Wide"] is true ? "container-fluid px-3 px-md-4" : "container")">
        <main role="main" class="pb-3">
            @if (TempData["Message"] is string message)
            {
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                    <i class="bi bi-check-circle-fill"></i><div>@message</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i><div>@error</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="text-muted small text-center py-4 d-none d-md-block">
        Family Budget &middot; @DateTime.Now.Year
    </footer>

    <!-- Phone navigation: a tab bar along the bottom of the screen -->
    <nav class="tab-bar d-md-none" aria-label="Main">
        @foreach (var item in nav)
        {
            <a class="@(controller == item.Controller ? "active" : "")" asp-controller="@item.Controller" asp-action="Index">
                <i class="bi @item.Icon"></i><span>@item.Label</span>
            </a>
        }
    </nav>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
